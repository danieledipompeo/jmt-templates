<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<jsimgt version="2">
    <meta author="pippo" date="2026-11-27" description="sdasndasionsaiosad" name="test-semplice" version="1.0"/>
    <parameters>
        <int default="1" label="Number of copies (group A)" max="1" min="1" name="n_A"/>
        <int default="2" label="Number of copies (group B)" max="16" min="1" name="n_B"/>
    </parameters>
    <model>
        <archive jmtVersion="1.5.0" name="test-semplice">
            <sim disableStatisticStop="false" maxEvents="-1" maxSamples="1000000" name="test-semplice" polling="1.0">
                <userClass name="Class1" priority="0" referenceSource="Source 1" softDeadline="0.0" type="open"/>
                <node name="Source 1">
                    <section className="RandomSource">
                        <parameter array="true" classPath="NetStrategies.ServiceStrategy" name="ServiceStrategy">
                            <refClass>Class1</refClass>
                            <subParameter classPath="NetStrategies.ServiceStrategies.ServiceTimeStrategy" name="ServiceTimeStrategy">
                                <subParameter classPath="random.Exponential" name="Exponential"/>
                                <subParameter classPath="random.ExponentialPar" name="distrPar">
                                    <subParameter classPath="java.lang.Double" name="lambda">
                                        <value>0.5</value>
                                    </subParameter>
                                </subParameter>
                            </subParameter>
                        </parameter>
                    </section>
                    <section className="ServiceTunnel"/>
                    <section className="Router">
                        <parameter array="true" classPath="NetStrategies.RoutingStrategy" name="RoutingStrategy">
                            <refClass>Class1</refClass>
                            <subParameter classPath="NetStrategies.RoutingStrategies.RandomStrategy" name="Random"/>
                        </parameter>
                    </section>
                </node>
                <node name="Queue 1">
                    <classSoftDeadlines>
                        <softDeadline>0.0</softDeadline>
                    </classSoftDeadlines>
                    <quantumSize>
                        <quantaSize>0.0</quantaSize>
                    </quantumSize>
                    <quantumSwitchoverTime>
                        <quantumSwitchoverTime>0.0</quantumSwitchoverTime>
                    </quantumSwitchoverTime>
                    <section className="Queue">
                        <parameter classPath="java.lang.Integer" name="size">
                            <value>-1</value>
                        </parameter>
                        <parameter array="true" classPath="java.lang.String" name="dropStrategies">
                            <refClass>Class1</refClass>
                            <subParameter classPath="java.lang.String" name="dropStrategy">
                                <value>drop</value>
                            </subParameter>
                        </parameter>
                        <parameter classPath="NetStrategies.QueueGetStrategies.FCFSstrategy" name="FCFSstrategy"/>
                        <parameter array="true" classPath="NetStrategies.QueuePutStrategy" name="QueuePutStrategy">
                            <refClass>Class1</refClass>
                            <subParameter classPath="NetStrategies.QueuePutStrategies.TailStrategy" name="TailStrategy"/>
                        </parameter>
                    </section>
                    <section className="Server">
                        <parameter classPath="java.lang.Integer" name="maxJobs">
                            <value>1</value>
                        </parameter>
                        <parameter array="true" classPath="java.lang.Integer" name="numberOfVisits">
                            <refClass>Class1</refClass>
                            <subParameter classPath="java.lang.Integer" name="numberOfVisits">
                                <value>1</value>
                            </subParameter>
                        </parameter>
                        <parameter array="true" classPath="NetStrategies.ServiceStrategy" name="ServiceStrategy">
                            <refClass>Class1</refClass>
                            <subParameter classPath="NetStrategies.ServiceStrategies.ServiceTimeStrategy" name="ServiceTimeStrategy">
                                <subParameter classPath="random.Exponential" name="Exponential"/>
                                <subParameter classPath="random.ExponentialPar" name="distrPar">
                                    <subParameter classPath="java.lang.Double" name="lambda">
                                        <value>1.0</value>
                                    </subParameter>
                                </subParameter>
                            </subParameter>
                        </parameter>
                        <parameter classPath="java.util.HashMap" map="true" name="advancedFeatures">
                            <subParameter array="true" classPath="java.lang.Integer" name="classParallelism">
                                <refClass>Class1</refClass>
                                <subParameter classPath="java.lang.Integer" name="serverParallelism">
                                    <value>1</value>
                                </subParameter>
                            </subParameter>
                            <subParameter array="true" classPath="java.lang.String" name="serverNames">
                                <subParameter classPath="java.lang.String" name="serverTypesNames">
                                    <value>Queue 1 - Server Type 1</value>
                                </subParameter>
                            </subParameter>
                            <subParameter array="true" classPath="java.lang.Integer" name="serversPerServerType">
                                <subParameter classPath="java.lang.Integer" name="serverTypesNumOfServers">
                                    <value>1</value>
                                </subParameter>
                            </subParameter>
                            <subParameter array="true" classPath="java.lang.Object" name="serverCompatibilities">
                                <subParameter array="true" classPath="java.lang.Boolean" name="serverTypesCompatibilities">
                                    <subParameter classPath="java.lang.Boolean" name="compatibilities">
                                        <value>true</value>
                                    </subParameter>
                                </subParameter>
                            </subParameter>
                            <subParameter classPath="java.lang.String" name="schedulingPolicy">
                                <value>ALIS (Assign Longest Idle Server)</value>
                            </subParameter>
                            <subParameter classPath="NetStrategies.VacationStrategies.NoVacationStrategy" name="vacationStrategy"/>
                        </parameter>
                    </section>
                    <section className="Router">
                        <parameter array="true" classPath="NetStrategies.RoutingStrategy" name="RoutingStrategy">
                            <refClass>Class1</refClass>
                            <subParameter classPath="NetStrategies.RoutingStrategies.RandomStrategy" name="Random"/>
                        </parameter>
                    </section>
                </node>
                <node name="Sink 1">
                    <section className="JobSink"/>
                </node>
                <measure alpha="0.01" name="System Response Time" nodeType="" precision="0.03" referenceNode="" referenceUserClass="" type="System Response Time" verbose="false"/>
                <connection source="Source 1" target="Queue 1"/>
                <connection source="Queue 1" target="Sink 1"/>
            </sim>
            <jmodel>
                <userClass color="#FF0000FF" name="Class1"/>
                <station name="Source 1">
                    <position angle="0.0" rotate="false" x="93.0" y="183.0"/>
                </station>
                <station name="Queue 1">
                    <position angle="0.0" rotate="false" x="246.0" y="179.0"/>
                </station>
                <station name="Sink 1">
                    <position angle="0.0" rotate="false" x="477.0" y="205.0"/>
                </station>
            </jmodel>
        </archive>
    </model>
    <groups>
        <group count="${n_A}" id="A">
            <station name="Source 1"/>
            <station name="Sink 1"/>
        </group>
        <group count="${n_B}" id="B">
            <station name="Queue 1"/>
        </group>
    </groups>
    <bindings/>
</jsimgt>
